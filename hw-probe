#!/bin/bash

# Discovers which sysfs files this machine exposes for CPU and GPU telemetry
# and prints them as JSON.
#
# This runs once when the widget loads, not on every tick. Sensor paths are
# stable for the life of a boot, so once they are known the widget samples by
# reading those files directly from inside the shell process — no subprocess
# per interval. Globbing and label matching is the one part that needs a
# shell, which is all this script is for.
#
# Nothing here requires root, and nothing is written.

set -uo pipefail

# ------------------------------------------------------------------ helpers

read_first() {
  [[ -r $1 ]] || return 1
  IFS= read -r line <"$1" 2>/dev/null || return 1
  printf '%s' "$line"
}

# JSON string escaping. Sensor and PCI names come from the kernel and lspci,
# so backslashes and quotes are unlikely but not impossible. Control
# characters (any C0 byte: CR, newline, ESC, ...) are stripped entirely and
# tabs become spaces, so the payload is always one clean JSON line — the
# consumer degrades to defaults on invalid JSON rather than misparsing.
json_str() {
  local s=${1//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//	/ }
  # Any remaining C0 control (CR, newline, ESC, ...) would produce invalid
  # one-line JSON; the consumer degrades to defaults on invalid JSON rather
  # than misparsing, but there is no reason to emit it in the first place.
  s=${s//[[:cntrl:]]/}
  printf '"%s"' "$s"
}

# Emit `"key": <json>` only when the path exists, so the consumer can treat a
# missing key as "this machine does not report that".
field_path() {
  local key=$1 path=$2
  [[ -n $path && -r $path ]] || return 0
  printf '%s: %s, ' "$(json_str "$key")" "$(json_str "$path")"
}

trim() {
  local s=$1
  s=${s#"${s%%[![:space:]]*}"}
  s=${s%"${s##*[![:space:]]}"}
  printf '%s' "$s"
}

# ---------------------------------------------------------------------- cpu

cpu_model=$(awk -F: '/^model name/ {sub(/^[ \t]+/, "", $2); print $2; exit}' /proc/cpuinfo)
# ARM boards have no "model name"; fall back to the SoC hardware line.
[[ -z $cpu_model ]] && cpu_model=$(awk -F: '/^Hardware|^Model/ {sub(/^[ \t]+/, "", $2); print $2; exit}' /proc/cpuinfo)
[[ -z $cpu_model ]] && cpu_model="CPU"
# Marketing suffixes eat tooltip width and say nothing.
cpu_model=$(trim "${cpu_model//(R)/}")
cpu_model=${cpu_model//(TM)/}
cpu_model=${cpu_model//(tm)/}
cpu_model=${cpu_model// CPU/}
# "16-Core Processor" duplicates the core count shown beside it.
cpu_model=$(sed -E 's/ [0-9]+-Core Processor//; s/ Processor$//' <<<"$cpu_model")
cpu_model=${cpu_model//  / }

cpu_threads=$(grep -c '^processor' /proc/cpuinfo)
# Physical cores = distinct (physical id, core id) pairs. SMT-less and
# heterogeneous (P/E core) CPUs fall back to the thread count.
cpu_cores=$(awk -F: '
  /^physical id/ { sub(/^[ \t]+/, "", $2); pkg = $2 }
  /^core id/     { sub(/^[ \t]+/, "", $2); seen[pkg "/" $2] = 1 }
  END { print length(seen) }
' /proc/cpuinfo)
[[ -z $cpu_cores || $cpu_cores -eq 0 ]] && cpu_cores=$cpu_threads

# Package temperature. Every vendor names this differently, so score the
# candidates and keep the best: a die/package reading beats a per-core or
# per-CCD one, and any dedicated CPU sensor beats the ACPI thermal zone.
cpu_temp_path=""
cpu_temp_label=""
cpu_temp_score=0

consider_cpu_temp() {
  local score=$1 path=$2 label=$3
  ((score > cpu_temp_score)) || return 0
  [[ -r $path ]] || return 0
  cpu_temp_score=$score
  cpu_temp_path=$path
  cpu_temp_label=$label
}

for hwmon in /sys/class/hwmon/hwmon*; do
  name=$(read_first "$hwmon/name") || continue
  for input in "$hwmon"/temp*_input; do
    [[ -r $input ]] || continue
    label=$(read_first "${input%_input}_label" || true)
    case "$name" in
      k10temp | zenpower)
        case "$label" in
          Tdie) consider_cpu_temp 100 "$input" "${label:-$name}" ;;
          Tctl) consider_cpu_temp 95 "$input" "${label:-$name}" ;;
          *) consider_cpu_temp 60 "$input" "${label:-$name}" ;;
        esac
        ;;
      coretemp)
        case "$label" in
          "Package id"*) consider_cpu_temp 90 "$input" "$label" ;;
          *) consider_cpu_temp 55 "$input" "${label:-$name}" ;;
        esac
        ;;
      *thinkpad*)
        [[ $label == CPU ]] && consider_cpu_temp 65 "$input" "$label"
        ;;
      cpu_thermal | soc_thermal | scpi_sensors | cpu-thermal)
        consider_cpu_temp 70 "$input" "${label:-$name}"
        ;;
      acpitz)
        consider_cpu_temp 20 "$input" "${label:-$name}"
        ;;
    esac
  done
done

# ---------------------------------------------------------------------- gpu

# lspci turns 1002:7550 into "Navi 48 [Radeon RX 9070 XT]", which is the only
# human-readable name a DRM card exposes. Missing pciutils just means the
# tooltip shows the driver name instead. Resolved once to an absolute path so
# the session PATH cannot substitute a different binary at call time.
lspci_bin=$(command -v lspci 2>/dev/null)
have_lspci=0
[[ -n $lspci_bin ]] && have_lspci=1

gpu_name_for() {
  local dev=$1 driver=$2 slot line name
  slot=$(sed -n 's/^PCI_SLOT_NAME=//p' "$dev/uevent" 2>/dev/null | head -1)
  if ((have_lspci)) && [[ -n $slot ]]; then
    line=$("$lspci_bin" -s "$slot" 2>/dev/null | head -1)
    # "0d:00.0 VGA compatible controller: AMD/ATI Navi 48 [Radeon RX 9070 XT]"
    name=${line#*: }
    name=${name%% (rev *}
    # Keep the marketing name inside the brackets when there is one.
    if [[ $name == *\[*\]* ]]; then
      local bracketed=${name##*[}
      bracketed=${bracketed%%]*}
      [[ -n $bracketed ]] && name=$bracketed
    fi
    name=$(trim "$name")
    [[ -n $name ]] && { printf '%s' "$name"; return; }
  fi
  printf '%s' "${driver:-GPU}"
}

# amdgpu exposes three temperatures (edge, junction, mem). Edge is the one
# every tool reports as "the" GPU temperature.
gpu_temp_for() {
  local hw=$1 input label
  for input in "$hw"/temp*_input; do
    [[ -r $input ]] || continue
    label=$(read_first "${input%_input}_label" || true)
    [[ $label == edge ]] && { printf '%s' "$input"; return; }
  done
  [[ -r $hw/temp1_input ]] && printf '%s' "$hw/temp1_input"
}

# Number of connectors currently driven by a DRM card. A connected output is
# stronger evidence for the GPU the user is looking at than merely exposing a
# load counter (integrated GPUs commonly expose one even when they drive no
# display). The count, rather than a boolean, makes docking setups deterministic.
connected_outputs_for() {
  local card=$1 status count=0
  for status in "$card"-*/status; do
    [[ -r $status ]] || continue
    [[ $(read_first "$status" || true) == connected ]] && ((count += 1))
  done
  printf '%d' "$count"
}

# Normalise the PCI domain's zero padding while preserving the complete BDF.
# nvidia-smi spells domain zero as 00000000; sysfs normally spells it 0000.
normalize_pci_bus() {
  local bus=${1,,} domain rest
  [[ $bus =~ ^([0-9a-f]+):([0-9a-f]{2}:[0-9a-f]{2}\.[0-7])$ ]] || return 1
  domain=${BASH_REMATCH[1]}
  rest=${BASH_REMATCH[2]}
  while [[ ${#domain} -gt 1 && $domain == 0* ]]; do domain=${domain#0}; done
  printf '%s:%s' "$domain" "$rest"
}

# Match the PCI bus id reported by nvidia-smi to its DRM card without assuming
# card numbering or conflating identical BDF suffixes in different domains.
drm_card_for_pci_bus() {
  local bus card slot normalized_slot
  bus=$(normalize_pci_bus "$1") || return 1
  for card in /sys/class/drm/card[0-9]*; do
    [[ $card == *-* || ! -d $card/device ]] && continue
    slot=$(sed -n 's/^PCI_SLOT_NAME=//p' "$card/device/uevent" 2>/dev/null | head -1)
    normalized_slot=$(normalize_pci_bus "$slot" || true)
    [[ -n $normalized_slot && $normalized_slot == "$bus" ]] && { printf '%s' "$card"; return 0; }
  done
  return 1
}

 # Intel GPUs have no gpu_busy_percent. What both drivers do expose, readable
# without root, is a running total of the time the render GT has spent idle in
# its RC6 power state; load is the share of the interval it did not. That is
# how busy the GT was kept rather than intel_gpu_top's per-engine figure (which
# needs perf and so root), but it tracks real use closely. The current clock is
# in MHz here, not in a hwmon freq1_input.
intel_idle_for() {
  local card=$1 dev=$2 driver=$3
  if [[ $driver == xe ]]; then
    printf '%s' "$dev/tile0/gt0/gtidle/idle_residency_ms"
  elif [[ -r $card/gt/gt0/rc6_residency_ms ]]; then
    printf '%s' "$card/gt/gt0/rc6_residency_ms"
  else
    printf '%s' "$card/power/rc6_residency_ms"
  fi
}

intel_clock_for() {
  local card=$1 dev=$2 driver=$3
  if [[ $driver == xe ]]; then
    printf '%s' "$dev/tile0/gt0/freq0/act_freq"
  elif [[ -r $card/gt/gt0/rps_act_freq_mhz ]]; then
    printf '%s' "$card/gt/gt0/rps_act_freq_mhz"
  else
    printf '%s' "$card/gt_act_freq_mhz"
  fi
}

gpu_entries=()
# Cards whose load can only be derived from idle time. They go after NVIDIA:
# on a hybrid laptop the iGPU used to be skipped outright, and "auto" should
# keep picking the discrete card it picked before.
idle_entries=()

for card in /sys/class/drm/card[0-9]*; do
  # Connectors are siblings named card1-DP-1; only the card itself has a device.
  [[ $card == *-* ]] && continue
  dev=$card/device
  [[ -d $dev ]] || continue

  driver=$(sed -n 's/^DRIVER=//p' "$dev/uevent" 2>/dev/null | head -1)

  # A headless Intel card is a render-offload dGPU that powers itself down
  # when idle. Its hwmon reads wake it and restart the autosuspend timer, so
  # sampling it every tick keeps it in D0 for good (~11 W on an Arc A370M).
  if [[ $driver == i915 || $driver == xe ]]; then
    connectors=("$card"-*)
    [[ -e ${connectors[0]} ]] || continue
  fi

  hw=""
  for candidate in "$dev"/hwmon/hwmon*; do
    [[ -d $candidate ]] && { hw=$candidate; break; }
  done

  entry="{"
  entry+="$(printf '%s: %s, ' "$(json_str kind)" "$(json_str "${driver:-drm}")")"
  entry+="$(printf '%s: %s, ' "$(json_str name)" "$(json_str "$(gpu_name_for "$dev" "$driver")")")"
  entry+="$(printf '%s: %s, ' "$(json_str card)" "$(json_str "${card##*/}")")"
  entry+="$(printf '%s: %s, ' "$(json_str connectedOutputs)" "$(connected_outputs_for "$card")")"
  entry+="$(field_path busyPath "$dev/gpu_busy_percent")"
  entry+="$(field_path vramUsedPath "$dev/mem_info_vram_used")"
  entry+="$(field_path vramTotalPath "$dev/mem_info_vram_total")"
  if [[ -n $hw ]]; then
    entry+="$(field_path tempPath "$(gpu_temp_for "$hw")")"
    # power1_average is the running average board draw; power1_input is the
    # instantaneous value some cards expose instead.
    if [[ -r $hw/power1_average ]]; then
      entry+="$(field_path powerPath "$hw/power1_average")"
    else
      entry+="$(field_path powerPath "$hw/power1_input")"
    fi
    entry+="$(field_path fanPath "$hw/fan1_input")"
    entry+="$(field_path clockPath "$hw/freq1_input")"
  fi
  if [[ $driver == i915 || $driver == xe ]]; then
    entry+="$(field_path idlePath "$(intel_idle_for "$card" "$dev" "$driver")")"
    entry+="$(field_path clockMhzPath "$(intel_clock_for "$card" "$dev" "$driver")")"
    # Reading the residency counter takes a runtime-PM reference, so a GT that
    # has suspended (screen blanked) would be woken on every tick. The widget
    # checks this first; runtime_status itself never wakes the device.
    entry+="$(field_path pmStatusPath "$dev/power/runtime_status")"
  fi
  entry=${entry%, }
  entry+="}"

  # A card that reports neither load nor temperature is not worth a slot.
  [[ $entry == *busyPath* || $entry == *idlePath* || $entry == *tempPath* ]] || continue

  # Cards that report load sort first: on a laptop with an iGPU and a dGPU the
  # one with a busy counter is the one the user means by "GPU".
  if [[ $entry == *busyPath* ]]; then
    gpu_entries=("$entry" "${gpu_entries[@]+"${gpu_entries[@]}"}")
  elif [[ $entry == *idlePath* ]]; then
    idle_entries+=("$entry")
  else
    gpu_entries+=("$entry")
  fi
done

# NVIDIA reports nothing useful through sysfs, so it gets sampled by polling
# nvidia-smi instead. Declared last: a sysfs-capable card is always cheaper.
# Resolved once to an absolute path; the widget reuses it (nvidiaPath) for its
# own sampling instead of re-resolving from the session PATH.
nv_bin=$(command -v nvidia-smi 2>/dev/null)
if [[ -n $nv_bin ]]; then
  # With no NVIDIA card nvidia-smi fails but prints its error on stdout, which
  # would otherwise be taken for a GPU name.
  # One entry per card: index is the id nvidia-smi --id expects. The list is
  # read first so a failing nvidia-smi (its exit status) registers no cards.
  # Each row also carries the PCI bus id, so the card can be matched to its DRM
  # node and report connected outputs alongside the sysfs entries.
  nv_idx=0
  nv_names=$("$nv_bin" --query-gpu=name,pci.bus_id --format=csv,noheader,nounits 2>/dev/null) || nv_names=""
  while IFS= read -r nv_row; do
    nv_row=$(trim "$nv_row")
    if [[ -n $nv_row && $nv_row == *,* ]]; then
      nv_name=$(trim "${nv_row%,*}")
      nv_bus=$(trim "${nv_row##*,}")
      nv="{$(printf '%s: %s, ' "$(json_str kind)" "$(json_str nvidia)")"
      nv+="$(printf '%s: %s, ' "$(json_str name)" "$(json_str "$nv_name")")"
      nv+="$(printf '%s: %s, ' "$(json_str nvidiaPath)" "$(json_str "$nv_bin")")"
      nv_card=$(drm_card_for_pci_bus "$nv_bus" || true)
      if [[ -n $nv_card ]]; then
        nv+="$(printf '%s: %s, ' "$(json_str card)" "$(json_str "${nv_card##*/}")")"
        nv+="$(printf '%s: %s, ' "$(json_str connectedOutputs)" "$(connected_outputs_for "$nv_card")")"
      fi
      nv+="$(printf '%s: %s' "$(json_str index)" "$nv_idx")}"
      gpu_entries+=("$nv")
      nv_idx=$((nv_idx + 1))
    fi
  done <<<"$nv_names"
fi

gpu_entries+=("${idle_entries[@]+"${idle_entries[@]}"}")

# -------------------------------------------------------------------- output

printf '{'
printf '"cpu": {'
printf '"model": %s, ' "$(json_str "$cpu_model")"
printf '"cores": %d, ' "$cpu_cores"
printf '"threads": %d' "$cpu_threads"
if [[ -n $cpu_temp_path ]]; then
  printf ', "tempPath": %s' "$(json_str "$cpu_temp_path")"
  printf ', "tempLabel": %s' "$(json_str "$cpu_temp_label")"
fi
printf '}, "gpus": ['
for i in "${!gpu_entries[@]}"; do
  ((i > 0)) && printf ', '
  printf '%s' "${gpu_entries[i]}"
done
printf ']}\n'
